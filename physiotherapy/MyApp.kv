#:import LabelBase kivy.core.text.LabelBase

<MainScreen>:
    BoxLayout:
        orientation:'vertical'
        padding:50
        spacing:30
        canvas.before:
            Color:
                rgba:0.1,0.1,0.12,1
            RoundedRectangle:
                pos:self.pos
                size:self.size
                radius:[25]

        Button:
            id: btn_elbow
            text:"آرنج"
            font_name:"Vazir.ttf"
            font_size:28
            size_hint:0.6,0.18
            pos_hint:{"center_x":0.5}
            background_normal:""
            background_color:0.5,0.2,0.7,1
            color:1,1,1,1
            border:(25,25,25,25)
            on_press: root.manager.current="elbow"

        Button:
            id: btn_knee
            text:"زانو"
            font_name:"Vazir.ttf"
            font_size:28
            size_hint:0.6,0.18
            pos_hint:{"center_x":0.5}
            background_normal:""
            background_color:0.5,0.2,0.7,1
            color:1,1,1,1
            border:(25,25,25,25)
            on_press: root.manager.current="knee"

        Button:
            id: btn_shoulder
            text:"شانه"
            font_name:"Vazir.ttf"
            font_size:28
            size_hint:0.6,0.18
            pos_hint:{"center_x":0.5}
            background_normal:""
            background_color:0.5,0.2,0.7,1
            color:1,1,1,1
            border:(25,25,25,25)
            on_press: root.manager.current="shoulder"


<ElbowScreen>:
    BoxLayout:
        orientation:'vertical'
        padding:10
        spacing:10
        canvas.before:
            Color:
                rgba:0.1,0.1,0.12,1
            RoundedRectangle:
                pos:self.pos
                size:self.size
                radius:[25]

        Image:
            id: cam_feed
            size_hint:1,0.65

        BoxLayout:
            orientation:'vertical'
            size_hint:1,0.3
            padding:10
            spacing:10
            canvas.before:
                Color:
                    rgba:0.3,0.2,0.4,1
                RoundedRectangle:
                    pos:self.pos
                    size:self.size
                    radius:[20]

            Label:
                id:left_elbow_label
                text:"زاویه آرنج چپ: ۰"
                font_name:"Vazir.ttf"
                font_size:24
                color:1,1,1,1
            ProgressBar:
                id:left_elbow_bar
                max:180
                value:0
                color:0.5,0.2,0.7,1

            Label:
                id:right_elbow_label
                text:"زاویه آرنج راست: ۰"
                font_name:"Vazir.ttf"
                font_size:24
                color:1,1,1,1
            ProgressBar:
                id:right_elbow_bar
                max:180
                value:0
                color:0.5,0.2,0.7,1

        Button:
            id: btn_back_elbow
            text:"بازگشت"
            font_name:"Vazir.ttf"
            font_size:28
            size_hint:0.3,0.1
            pos_hint:{"center_x":0.5}
            background_normal:""
            background_color:0.5,0.2,0.7,1
            color:1,1,1,1
            on_press: root.manager.current="main"


