                color:0.5,0.2,0.7,1

        Button:
            id: btn_back_knee
            text:"بازگشت"
            font_name:"Vazir.ttf"
            font_size:28
            size_hint:0.3,0.1
            pos_hint:{"center_x":0.5}
            background_normal:""
            background_color:0.5,0.2,0.7,1
            color:1,1,1,1
            on_press: root.manager.current="main"


<ShoulderScreen>:
    BoxLayout:
        orientation:'vertical'
        padding:10
        spacing:10
        canvas.before:
            Color:
                rgba:0.1,0.1,0.12,1
            RoundedRectangle:
                pos:self.pos
                size:self.size
                radius:[25]

        Image:
            id: cam_feed
            size_hint:1,0.75

        Button:
            id: btn_back_shoulder
            text:"بازگشت"
            font_name:"Vazir.ttf"
            font_size:28
            size_hint:0.3,0.1
            pos_hint:{"center_x":0.5}
            background_normal:""
            background_color:0.5,0.2,0.7,1
